# Copy to .env (never commit .env). Values here are for local development only.

# PostgreSQL
POSTGRES_DB=nobodyfalls
POSTGRES_USER=nobodyfalls
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# Redis (SignalR backplane, step d)
REDIS_PORT=6379

# Application
APP_PORT=8080
# Dev tools: dev login, simulated clock, fake players and bots. Never in production.
DEV_TOOLS=true

# Sign-in providers: leave empty to hide them (the dev login works without them).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Cloudflare Turnstile. Defaults are Cloudflare's public test keys (always pass).
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Used by `dotnet ef` when generating migrations against a local database.
NOBODYFALLS_DB=Host=localhost;Port=5432;Database=nobodyfalls;Username=nobodyfalls;Password=change-me-locally
