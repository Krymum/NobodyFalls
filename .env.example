# Copy to .env (never commit .env). Values here are for local development only.

# PostgreSQL
POSTGRES_DB=nobodyfalls
POSTGRES_USER=nobodyfalls
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# Redis (SignalR backplane, step d)
REDIS_PORT=6379

# Used by `dotnet ef` when generating migrations against a local database.
NOBODYFALLS_DB=Host=localhost;Port=5432;Database=nobodyfalls;Username=nobodyfalls;Password=change-me-locally
