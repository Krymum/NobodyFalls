{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "Auth": {
    "SecureCookies": true,
    "Google": { "ClientId": "", "ClientSecret": "" },
    "Discord": { "ClientId": "", "ClientSecret": "" }
  },
  "Turnstile": {
    "SiteKey": "",
    "SecretKey": ""
  },
  "Push": {
    "PublicKey": "",
    "PrivateKey": "",
    "Subject": "mailto:contact@nobodyfalls.com"
  },
  "DevTools": {
    "Enabled": false
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Night": {
    "RunWorker": true
  },
  "Proxy": {
    "TrustForwardedHeaders": false
  },
  "RateLimits": {
    "PerIpPerMinute": 300,
    "HandsPerPlayerPerMinute": 12,
    "FriendsPerPlayerPerMinute": 30,
    "RegistrationsPerIpPerHour": 10
  }
}
